{
  "name": "tabtivity",
  "private": true,
  "version": "0.2.19",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript-native/bin/tsc && vite build && npm run mobile:build && npm run web:bundle",
    "mobile:build": "node node_modules/typescript-native/bin/tsc -p tsconfig.mobile.json && npm run mobile:bundle",
    "mobile:bundle": "vite build --config vite.mobile.config.ts && vite build --config vite.pdf-frame.config.ts",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "web:bundle": "vite build --config vite.web.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "pretauri:dev": "./scripts/guard-single-instance.sh",
    "tauri:dev": "tauri dev --no-watch",
    "pretauri:dev:watch": "./scripts/guard-single-instance.sh",
    "tauri:dev:watch": "tauri dev",
    "backend:stale": "./scripts/backend-stale.sh",
    "tauri:build": "tauri build",
    "tauri:bundle": "tauri build --bundles appimage,deb",
    "tauri:bundle:mac": "tauri build --bundles dmg",
    "package": "./scripts/package-local.sh",
    "package:dev": "./scripts/package-dev.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "untested": "node scripts/untested.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-notification": "^2.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "mermaid": "^11.16.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18",
    "react-dom": "^18",
    "uqr": "^0.1.3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "react-scan": "^0.5.7",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.0"
  },
  "overrides": {
    "mermaid": {
      "katex": "$katex"
    }
  }
}
