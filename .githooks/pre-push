#!/usr/bin/env bash
#
# Two jobs, in this order:
#
#   1. Privacy scan. This repo is public, so every push is scanned for secrets
#      and personal data first — running it before the bump means a hit aborts
#      the push without leaving a stray version-bump commit behind.
#   2. Auto-bump the patch version on every push of a branch, so each pushed
#      build is a distinct version. Releases stay manual: release.yml cuts
#      one from a commit whose ci-cd run passed — dispatched, or on a pushed
#      v* tag, which this hook deliberately doesn't bump.
#
# git can't add a commit to a push that is already in flight, so this hook:
#   1. bumps package.json / Cargo.toml / tauri.conf.json / Cargo.lock,
#   2. commits the bump onto the current branch,
#   3. re-runs the push (which carries the bump), and
#   4. aborts the original push, now superseded by the re-push.
#
# Enable once with:  git config core.hooksPath .githooks
set -euo pipefail

# The hook's switches carry the app's name. A hook runs in any state of the
# tree, so it cannot source scripts/lib/brand.sh and spells both names itself:
# the current one, and the one the app had before it was renamed — a shell
# that still exports the old switch, or an older build of the app running this
# hook, must not be ignored. brand-check: allow — until the cleanup release.
app_var() { local new="TABTIVITY_$1" old="ELDRUN_$1"; printf '%s' "${!new:-${!old:-}}"; }

# Guard against the recursion from our own re-push below.
[ -n "$(app_var BUMPING)" ] && exit 0

remote="$1"

repo_root="$(git rev-parse --show-toplevel)"

# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha> per pushed ref.
# Bump only when pushing a branch whose version still matches what is already on
# the remote (or a brand-new remote branch). This skips:
#   - pure tag / deletion pushes (e.g. `git push origin v0.1.8` to cut a release),
#   - pushes where the version was already advanced manually (minor/major bump),
# so the version on the remote strictly increases on each push without ever
# double-bumping.
pkg_version() { git show "$1:package.json" 2>/dev/null | jq -r '.version // empty' 2>/dev/null; }

# The empty tree — the diff base for a push with no ancestor on the remote.
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904

# Release signing (#160): the release job refuses to publish without the
# RELEASE_SIGNING_KEY repository secret. Warn on every push while it is
# missing; a v* tag push, which would cut a doomed release, stops. Once the
# secret is seen, a marker in .git skips the check for good. No gh, no network
# or no admin access to the secrets (a fork, a contributor) → silent.
signing_marker="$(git rev-parse --git-dir)/tabtivity-release-signing-secret-ok"
# The marker a push made before the rename left, under the app's old name.
# brand-check: allow — until the cleanup release
old_signing_marker="$(git rev-parse --git-dir)/eldrun-release-signing-secret-ok"
signing_secret_missing() {
  [ -e "$signing_marker" ] || [ -e "$old_signing_marker" ] && return 1
  command -v gh >/dev/null 2>&1 || return 1
  local names
  names="$(cd "$repo_root" && timeout 10 gh secret list --json name -q '.[].name' </dev/null 2>/dev/null)" || return 1
  if printf '%s\n' "$names" | grep -qx RELEASE_SIGNING_KEY; then
    touch "$signing_marker"
    return 1
  fi
  return 0
}
signing_missing=0
# Tabtivity's agent-push preflight (TABTIVITY_PUSH_PREFLIGHT=1, see
# docs/context/git_push_mcp.md) runs this hook inside the agent's sandbox with
# no credentials: the signing reminder is for the user's own pushes (it needs
# gh and the network), and a v* tag can't be pushed through that lane anyway.
if [ -z "$(app_var BUMPING)" ] && [ -z "$(app_var PUSH_PREFLIGHT)" ] && signing_secret_missing; then
  signing_missing=1
  echo "pre-push: REMINDER — the RELEASE_SIGNING_KEY secret is not set on GitHub." >&2
  echo "          The next v* release will fail at signing until it is:" >&2
  echo "          gh secret set RELEASE_SIGNING_KEY < <the key file scripts/release-signing-keygen.sh wrote>" >&2
  echo "          Step by step: docs/context/release_signing.md" >&2
fi

# A hit here is still only local: nothing has left the machine. Say how to get
# it out of history before the retry.
privacy_fail() {
  local onto="$1"
  [ "$onto" = "$EMPTY_TREE" ] && onto="--root"
  echo "pre-push: privacy check failed for ${remote_ref} — push aborted." >&2
  echo "          Review each match above; this repo is public. Nothing was sent:" >&2
  echo "          fix the last commit with 'git commit --amend', an older one with" >&2
  echo "          'git rebase -i $onto' (edit/drop), then push again." >&2
  echo "          A real credential that sat in a commit is safest rotated." >&2
  echo "          To override once: TABTIVITY_SKIP_PRIVACY_CHECK=1 git push …" >&2
  exit 1
}

bump=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # A deletion publishes nothing.
  [[ "$local_sha" =~ ^0+$ ]] && continue

  # What gets scanned is decided by what is PUBLISHED, never by the local ref's
  # name: `git push origin HEAD:develop` and a detached HEAD arrive with the
  # local ref `HEAD`, and a filter on that name once let them through unscanned.
  # Tags publish their commits too. Only a branch push is version-bumped, as
  # before (the bump re-pushes HEAD, which only makes sense from a branch).
  bumpable=0
  case "$remote_ref" in
    refs/tags/v*)
      if [ "$signing_missing" -eq 1 ] && [ -z "$(app_var SKIP_SIGNING_CHECK)" ]; then
        echo "pre-push: not pushing ${remote_ref#refs/tags/}: its release would fail unsigned." >&2
        echo "          Set the secret first, or override once: TABTIVITY_SKIP_SIGNING_CHECK=1 git push …" >&2
        exit 1
      fi ;;
    refs/tags/*) : ;;
    *) [[ "$local_ref" == refs/* && "$local_ref" != refs/tags/* ]] && bumpable=1 ;;
  esac

  # Scan exactly what this ref is about to publish. The remote tip is the base
  # when the ref already exists there; for a brand-new remote ref, walk back to
  # the parent of the oldest commit no remote ref has yet, so the scan covers
  # the new commits and not the whole history — and nothing, when every commit
  # is already there. A tag is scanned as the commit it points at.
  head_commit="$(git -C "$repo_root" rev-parse -q --verify "$local_sha^{commit}" 2>/dev/null || true)"
  scan=1
  if [ -z "$head_commit" ]; then
    scan=0                        # a tag of a tree or blob: no commits to publish
  elif [[ "$remote_sha" =~ ^0+$ ]]; then
    oldest_new="$(git -C "$repo_root" rev-list "$head_commit" --not --remotes="$remote" | tail -1)"
    if [ -z "$oldest_new" ]; then
      scan=0
    else
      base="$(git -C "$repo_root" rev-parse -q --verify "$oldest_new^" 2>/dev/null || true)"
      [ -n "$base" ] || base="$EMPTY_TREE"   # the ref reaches a root commit
    fi
  else
    base="$remote_sha"
  fi

  # </dev/null: this loop owns stdin (git's ref list) — a child must not eat it.
  if [ "$scan" -eq 1 ] && [ -z "$(app_var SKIP_PRIVACY_CHECK)" ]; then
    if ! (cd "$repo_root" && scripts/privacy-check.sh "$base" "$head_commit") </dev/null; then
      privacy_fail "$base"
    fi
    # Same optional gitleaks pass as pre-commit, over the commits being pushed.
    if command -v gitleaks >/dev/null 2>&1; then
      range="$head_commit"
      [ "$base" = "$EMPTY_TREE" ] || range="$base..$head_commit"
      (cd "$repo_root" && gitleaks git --log-opts="$range" --redact --no-banner --verbose --log-level=warn) </dev/null \
        || privacy_fail "$base"
    fi
  fi

  [ "$bumpable" -eq 1 ] || continue
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    bump=1                        # new branch on the remote — give it a fresh version
  elif [ "$(pkg_version "$local_sha")" = "$(pkg_version "$remote_sha")" ]; then
    bump=1                        # version unchanged since last push — bump it
  fi
done

[ "$bump" -eq 0 ] && exit 0

new="$("$repo_root/scripts/bump-version.sh" patch)"

# Cargo.lock carries the workspace's own version too, so it is part of the bump
# — staged with the rest or the bump commit leaves the tree dirty behind it.
# `--` and the explicit list keep this to the version files: a push must never
# sweep up whatever else happens to be in the working tree.
git -C "$repo_root" add -- \
  package.json src-tauri/Cargo.toml src-tauri/tauri.conf.json Cargo.lock
# TABTIVITY_VERSION_BUMP tells post-commit this is the push's own bump: its
# phone-staleness advisory has nothing to do with pushing, and git routes a
# hook's output to stderr, where it read as the push's error.
TABTIVITY_VERSION_BUMP=1 git -C "$repo_root" commit -m "chore: bump version to v${new}" >/dev/null

# Under Tabtivity's preflight there is nothing to re-push with: the bump commit
# is on the branch, Tabtivity's own transport (hooks off, with the token this
# sandbox never sees) carries it. Exit 0 = "go ahead".
if [ -n "$(app_var PUSH_PREFLIGHT)" ]; then
  echo "pre-push: bumped version to v${new}; Tabtivity's transport carries the bump." >&2
  exit 0
fi

echo "pre-push: bumped version to v${new}; pushing with the bump included…" >&2
TABTIVITY_BUMPING=1 git push "$remote" HEAD
echo "pre-push: pushed v${new}. The 'failed to push' line below is the original" >&2
echo "          pre-bump push being intentionally aborted — the push succeeded." >&2

# The re-push above already sent the bump commit; stop the original (stale) push.
exit 1
