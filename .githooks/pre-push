#!/usr/bin/env bash
#
# Two jobs, in this order:
#
#   1. Privacy scan. This repo is public, so every push is scanned for secrets
#      and personal data first — running it before the bump means a hit aborts
#      the push without leaving a stray version-bump commit behind.
#   2. Auto-bump the patch version on every push of a branch, so each pushed
#      build is a distinct version. Releases stay manual: release.yml cuts
#      one from a commit whose ci-cd run passed — dispatched, or on a pushed
#      v* tag, which this hook deliberately doesn't bump.
#
# git can't add a commit to a push that is already in flight, so this hook:
#   1. bumps package.json / package-lock.json / Cargo.toml / tauri.conf.json /
#      Cargo.lock,
#   2. commits the bump onto the current branch — those five files only, from
#      a private index, whatever else is staged,
#   3. re-runs the push (which carries the bump), and
#   4. aborts the original push, now superseded by the re-push.
#
# Enable once with:  git config core.hooksPath .githooks
set -euo pipefail

# The hook's switches carry the app's name. A hook runs in any state of the
# tree, so it cannot source scripts/lib/brand.sh and spells both names itself:
# the current one, and the one the app had before it was renamed — a shell
# that still exports the old switch, or an older build of the app running this
# hook, must not be ignored. brand-check: allow — until the cleanup release.
app_var() { local new="TABTIVITY_$1" old="ELDRUN_$1"; printf '%s' "${!new:-${!old:-}}"; }

# Guard against the recursion from our own re-push below.
[ -n "$(app_var BUMPING)" ] && exit 0

remote="$1"

repo_root="$(git rev-parse --show-toplevel)"

# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha> per pushed ref.
# Bump only when pushing a branch whose version still matches what is already on
# the remote (or a brand-new remote branch). This skips:
#   - pure tag / deletion pushes (e.g. `git push origin v0.1.8` to cut a release),
#   - pushes where the version was already advanced manually (minor/major bump),
# so the version on the remote strictly increases on each push without ever
# double-bumping.
pkg_version() { git show "$1:package.json" 2>/dev/null | jq -r '.version // empty' 2>/dev/null; }

# The empty tree — the diff base for a push with no ancestor on the remote.
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904

# Release signing (#160): the release job refuses to publish without the
# RELEASE_SIGNING_KEY repository secret. Warn on every push while it is
# missing; a v* tag push, which would cut a doomed release, stops. Once the
# secret is seen, a marker in .git skips the check for good. No gh, no network
# or no admin access to the secrets (a fork, a contributor) → silent.
signing_marker="$(git rev-parse --git-dir)/tabtivity-release-signing-secret-ok"
# The marker a push made before the rename left, under the app's old name.
# brand-check: allow — until the cleanup release
old_signing_marker="$(git rev-parse --git-dir)/eldrun-release-signing-secret-ok"
signing_secret_missing() {
  [ -e "$signing_marker" ] || [ -e "$old_signing_marker" ] && return 1
  command -v gh >/dev/null 2>&1 || return 1
  local names
  names="$(cd "$repo_root" && timeout 10 gh secret list --json name -q '.[].name' </dev/null 2>/dev/null)" || return 1
  if printf '%s\n' "$names" | grep -qx RELEASE_SIGNING_KEY; then
    touch "$signing_marker"
    return 1
  fi
  return 0
}
signing_missing=0
# Tabtivity's agent-push preflight (TABTIVITY_PUSH_PREFLIGHT=1, see
# docs/context/git_push_mcp.md) runs this hook inside the agent's sandbox with
# no credentials: the signing reminder is for the user's own pushes (it needs
# gh and the network), and a v* tag can't be pushed through that lane anyway.
if [ -z "$(app_var BUMPING)" ] && [ -z "$(app_var PUSH_PREFLIGHT)" ] && signing_secret_missing; then
  signing_missing=1
  echo "pre-push: REMINDER — the RELEASE_SIGNING_KEY secret is not set on GitHub." >&2
  echo "          The next v* release will fail at signing until it is:" >&2
  echo "          gh secret set RELEASE_SIGNING_KEY < <the key file scripts/release-signing-keygen.sh wrote>" >&2
  echo "          Step by step: docs/context/release_signing.md" >&2
fi

# A hit here is still only local: nothing has left the machine. Say how to get
# it out of history before the retry.
privacy_fail() {
  local onto="$1"
  [ "$onto" = "$EMPTY_TREE" ] && onto="--root"
  echo "pre-push: privacy check failed for ${remote_ref} — push aborted." >&2
  echo "          Review each match above; this repo is public. Nothing was sent:" >&2
  echo "          fix the last commit with 'git commit --amend', an older one with" >&2
  echo "          'git rebase -i $onto' (edit/drop), then push again." >&2
  echo "          A real credential that sat in a commit is safest rotated." >&2
  echo "          To override once: TABTIVITY_SKIP_PRIVACY_CHECK=1 git push …" >&2
  exit 1
}

# Red CI on a pushed branch: new work landing on a failed ci-cd run buries the
# failure under the next one, so say so — but only say it. Best effort and
# never blocking: no curl or jq, no network (the agent-push preflight's sandbox
# may have none), a rate limit, or a remote that isn't GitHub → silent.
# Prints owner/repo for a GitHub remote URL; fails for anything else.
github_repo_of() {
  local url="${1%/}"
  local re='^(https://([^@/]+@)?github\.com/|ssh://git@github\.com/|git@github\.com:)([^/]+)/([^/]+)$'
  [[ "$url" =~ $re ]] || return 1
  local owner="${BASH_REMATCH[3]}" name="${BASH_REMATCH[4]%.git}"
  [ -n "$name" ] || return 1
  printf '%s/%s\n' "$owner" "$name"
}
# The newest finished ci-cd run of a branch, skipping runs a newer push
# cancelled (ci-cd.yml's concurrency), which say nothing about the code.
warn_if_ci_red() {
  local slug="$1" branch="$2" q json run
  command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  q="$(jq -rn --arg b "$branch" '$b | @uri' 2>/dev/null)" || return 0
  json="$(curl -fsS --max-time 5 -H 'Accept: application/vnd.github+json' \
    "https://api.github.com/repos/$slug/actions/workflows/ci-cd.yml/runs?branch=$q&status=completed&per_page=10" \
    </dev/null 2>/dev/null)" || return 0
  run="$(jq -r 'first(.workflow_runs[]? | select(.conclusion != "cancelled" and .conclusion != "skipped"))
                | select(.conclusion == "failure") | "#\(.run_number) \(.html_url)"' <<<"$json" 2>/dev/null)" || return 0
  [ -n "$run" ] || return 0
  echo "pre-push: WARNING — the last ci-cd run on $branch failed: $run" >&2
  echo "          Pushing anyway. Don't stack new work on a red run: the next push should be its fix." >&2
}
ci_branches=()

bump=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # A deletion publishes nothing.
  [[ "$local_sha" =~ ^0+$ ]] && continue
  if [[ "$remote_ref" == refs/heads/* ]]; then
    ci_branches+=("${remote_ref#refs/heads/}")
  fi

  # What gets scanned is decided by what is PUBLISHED, never by the local ref's
  # name: `git push origin HEAD:develop` and a detached HEAD arrive with the
  # local ref `HEAD`, and a filter on that name once let them through unscanned.
  # Tags publish their commits too. Only a branch push is version-bumped, as
  # before (the bump re-pushes HEAD, which only makes sense from a branch).
  bumpable=0
  case "$remote_ref" in
    refs/tags/v*)
      if [ "$signing_missing" -eq 1 ] && [ -z "$(app_var SKIP_SIGNING_CHECK)" ]; then
        echo "pre-push: not pushing ${remote_ref#refs/tags/}: its release would fail unsigned." >&2
        echo "          Set the secret first, or override once: TABTIVITY_SKIP_SIGNING_CHECK=1 git push …" >&2
        exit 1
      fi
      # release.yml releases only what main holds and deletes any other v* tag
      # again; say so before the tag leaves. Checked against the last fetch.
      if ! git -C "$repo_root" merge-base --is-ancestor "$local_sha^{commit}" "refs/remotes/$remote/main" 2>/dev/null; then
        echo "pre-push: not pushing ${remote_ref#refs/tags/}: its commit is not on $remote/main, and only main is released." >&2
        echo "          Merge develop into main by PR, 'git fetch', then tag main's tip." >&2
        exit 1
      fi ;;
    refs/tags/*) : ;;
    *) [[ "$local_ref" == refs/* && "$local_ref" != refs/tags/* ]] && bumpable=1 ;;
  esac

  # Scan exactly what this ref is about to publish. The remote tip is the base
  # when the ref already exists there; for a brand-new remote ref, walk back to
  # the parent of the oldest commit no remote ref has yet, so the scan covers
  # the new commits and not the whole history — and nothing, when every commit
  # is already there. A tag is scanned as the commit it points at.
  head_commit="$(git -C "$repo_root" rev-parse -q --verify "$local_sha^{commit}" 2>/dev/null || true)"
  scan=1
  if [ -z "$head_commit" ]; then
    scan=0                        # a tag of a tree or blob: no commits to publish
  elif [[ "$remote_sha" =~ ^0+$ ]]; then
    oldest_new="$(git -C "$repo_root" rev-list "$head_commit" --not --remotes="$remote" | tail -1)"
    if [ -z "$oldest_new" ]; then
      scan=0
    else
      base="$(git -C "$repo_root" rev-parse -q --verify "$oldest_new^" 2>/dev/null || true)"
      [ -n "$base" ] || base="$EMPTY_TREE"   # the ref reaches a root commit
    fi
  else
    base="$remote_sha"
  fi

  # </dev/null: this loop owns stdin (git's ref list) — a child must not eat it.
  if [ "$scan" -eq 1 ] && [ -z "$(app_var SKIP_PRIVACY_CHECK)" ]; then
    if ! (cd "$repo_root" && scripts/privacy-check.sh "$base" "$head_commit") </dev/null; then
      privacy_fail "$base"
    fi
    # Same optional gitleaks pass as pre-commit, over the commits being pushed.
    if command -v gitleaks >/dev/null 2>&1; then
      range="$head_commit"
      [ "$base" = "$EMPTY_TREE" ] || range="$base..$head_commit"
      (cd "$repo_root" && gitleaks git --log-opts="$range" --redact --no-banner --verbose --log-level=warn) </dev/null \
        || privacy_fail "$base"
    fi
  fi

  [ "$bumpable" -eq 1 ] || continue
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    bump=1                        # new branch on the remote — give it a fresh version
  elif [ "$(pkg_version "$local_sha")" = "$(pkg_version "$remote_sha")" ]; then
    bump=1                        # version unchanged since last push — bump it
  fi
done

# After the privacy scan, before the bump's re-push (which skips this hook).
if [ "${#ci_branches[@]}" -gt 0 ] && ci_repo="$(github_repo_of "${2:-$(git remote get-url "$remote" 2>/dev/null || true)}")"; then
  for ci_branch in "${ci_branches[@]}"; do
    warn_if_ci_red "$ci_repo" "$ci_branch" || true
  done
fi

[ "$bump" -eq 0 ] && exit 0

# The bump commit is made from a private index holding HEAD plus the five
# version files, never from the shared one: whatever else is staged must not
# ride into a commit this hook makes after the scan (the scan covered HEAD, and
# the re-push skips the hook). That leaves the version files themselves, which
# bump-version.sh rewrites in the working tree — an uncommitted edit in one of
# them would ride along unscanned, so the bump stops instead.
bump_files=(package.json package-lock.json src-tauri/Cargo.toml src-tauri/tauri.conf.json Cargo.lock)
if ! git -C "$repo_root" diff --quiet HEAD -- "${bump_files[@]}"; then
  echo "pre-push: not bumping — the version files carry uncommitted changes:" >&2
  git -C "$repo_root" diff --name-only HEAD -- "${bump_files[@]}" | sed 's/^/          /' >&2
  echo "          Commit or revert them, then push again." >&2
  exit 1
fi

# A bump that fails halfway must not leave the tree behind it half-bumped: the
# working tree would carry bumped version files (and the next push refuse on
# them), and a bump commit whose shared-index reset failed would leave the
# index staging the *old* versions — the next commit would quietly revert the
# bump. So every step below that can fail undoes the whole bump instead: the
# bump commit comes off the branch again (ref only, compare-and-swap on its
# sha, so nothing newer is ever dropped) and the five files get HEAD's bytes
# back, written straight from the blobs — no index lock needed, since a held
# `index.lock` is exactly what makes the reset fail. The shared index was never
# touched before the reset, and the check above made the files match HEAD, so
# that is the state before the push, exactly.
pre_bump="$(git -C "$repo_root" rev-parse HEAD)"
bump_sha=""
restore_version_files() {
  local f tmp failed=0
  for f in "${bump_files[@]}"; do
    git -C "$repo_root" cat-file -e "$pre_bump:$f" 2>/dev/null || continue
    tmp="$repo_root/$f.pre-push-restore"
    if git -C "$repo_root" cat-file blob "$pre_bump:$f" >"$tmp" 2>/dev/null && mv -f "$tmp" "$repo_root/$f"; then
      :
    else
      rm -f "$tmp"
      failed=1
    fi
  done
  return "$failed"
}
bump_failed() {
  echo "pre-push: the version bump failed ($1) — push aborted, nothing was sent." >&2
  if [ -n "$bump_sha" ]; then
    if git -C "$repo_root" update-ref -m "pre-push: undo a failed version bump" HEAD "$pre_bump" "$bump_sha" 2>/dev/null; then
      echo "          The bump commit ${bump_sha:0:12} was taken back off the branch." >&2
    else
      echo "          The bump commit ${bump_sha:0:12} is still on the branch and the index" >&2
      echo "          still stages the old version files. Before committing anything, run:" >&2
      echo "            git reset -q -- ${bump_files[*]}" >&2
      exit 1
    fi
  fi
  if restore_version_files; then
    echo "          The version files are back as they were; push again." >&2
  else
    echo "          Could not put the version files back; restore them with:" >&2
    echo "            git checkout HEAD -- ${bump_files[*]}" >&2
  fi
  exit 1
}

new="$("$repo_root/scripts/bump-version.sh" patch)" || bump_failed "scripts/bump-version.sh"

# The private index lives in the git dir, not /tmp: under Tabtivity's fenced
# push preflight .git is writable and /tmp is not shared. mktemp reserves the
# name, and the empty file goes again so read-tree writes a fresh index
# instead of parsing a zero-byte one.
bump_index="$(mktemp "$(git -C "$repo_root" rev-parse --absolute-git-dir)/bump-index.XXXXXX")" \
  || bump_failed "no private index"
trap 'rm -f "$bump_index" "$bump_index.lock"' EXIT
rm -f "$bump_index"
GIT_INDEX_FILE="$bump_index" git -C "$repo_root" read-tree HEAD \
  || bump_failed "reading HEAD into the private index"
# Cargo.lock and package-lock.json carry the app's own version too, so they are
# part of the bump — committed with the rest or the bump commit leaves the tree
# dirty behind it (or, for package-lock.json, quietly a version behind).
GIT_INDEX_FILE="$bump_index" git -C "$repo_root" add -- "${bump_files[@]}" \
  || bump_failed "staging the version files in the private index"
# TABTIVITY_VERSION_BUMP tells post-commit this is the push's own bump: its
# phone-staleness advisory has nothing to do with pushing, and git routes a
# hook's output to stderr, where it read as the push's error.
# The identity comes from git config, never the caller's environment: an agent
# session that exports GIT_AUTHOR_*/GIT_COMMITTER_* would otherwise stamp the
# bump with a non-noreply address and fail the privacy scan in CI.
bump_name="$(git -C "$repo_root" config user.name)"
bump_email="$(git -C "$repo_root" config user.email)"
GIT_INDEX_FILE="$bump_index" TABTIVITY_VERSION_BUMP=1 \
  GIT_AUTHOR_NAME="$bump_name" GIT_AUTHOR_EMAIL="$bump_email" \
  GIT_COMMITTER_NAME="$bump_name" GIT_COMMITTER_EMAIL="$bump_email" \
  git -C "$repo_root" commit -m "chore: bump version to v${new}" >/dev/null \
  || bump_failed "the bump commit"
bump_sha="$(git -C "$repo_root" rev-parse HEAD)"
# The scan above ran before this commit existed, so CI would be the first to
# see it: scan the bump itself and take it back if it would fail there.
if [ -z "$(app_var SKIP_PRIVACY_CHECK)" ] \
  && ! (cd "$repo_root" && scripts/privacy-check.sh "$bump_sha~1" "$bump_sha") </dev/null; then
  bump_failed "the privacy scan of the bump commit"
fi
# The shared index still holds the pre-bump version files: point those five
# entries at the bump commit. Anything else staged there stays staged.
git -C "$repo_root" reset -q -- "${bump_files[@]}" \
  || bump_failed "resetting the version files in the shared index"

# Under Tabtivity's preflight there is nothing to re-push with: the bump commit
# is on the branch, Tabtivity's own transport (hooks off, with the token this
# sandbox never sees) carries it. Exit 0 = "go ahead".
if [ -n "$(app_var PUSH_PREFLIGHT)" ]; then
  echo "pre-push: bumped version to v${new}; Tabtivity's transport carries the bump." >&2
  exit 0
fi

echo "pre-push: bumped version to v${new}; pushing with the bump included…" >&2
TABTIVITY_BUMPING=1 git push "$remote" HEAD
echo "pre-push: pushed v${new}. The 'failed to push' line below is the original" >&2
echo "          pre-bump push being intentionally aborted — the push succeeded." >&2

# The re-push above already sent the bump commit; stop the original (stale) push.
exit 1
